# ==========================================
# ALGOLAB - Environment Configuration Template
# Never put real passwords or API keys in this file.
# ==========================================

# Application Port & Host
PORT=3001
HOST=127.0.0.1

# CORS Allowed Origins (comma-separated list for remote Netlify or custom domains)
ALLOWED_ORIGIN=https://thriving-tanuki-9df908.netlify.app
ALLOW_NULL_ORIGIN=false

# Runner Execution & Resource Limits
MAX_CONCURRENCY=2
REQUEST_TIMEOUT_MS=25000
MAX_BODY_BYTES=131072
MAX_SOURCE_BYTES=65536

# Database Configuration (Planned)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=algolab
DB_USER=your_local_db_user
DB_PASSWORD=replace_with_your_local_password