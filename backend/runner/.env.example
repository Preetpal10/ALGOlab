# =============================================================================
# ALGOLAB — Backend Runner Local Environment Configuration Template
#
# Copy this file to '.env' in this directory and replace placeholders with
# your local database credentials.
# Never commit real passwords, secrets, or production keys to version control.
# =============================================================================

# Server Port & Binding
PORT=3001
HOST=127.0.0.1

# MySQL Database Connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=algolab
DB_USER=algolab_app
DB_PASSWORD=replace_with_a_secure_password
DB_CONNECTION_LIMIT=10

# CORS Allowed Origins (comma-separated for remote frontend, e.g. Netlify)
ALLOWED_ORIGIN=http://localhost:8000,http://127.0.0.1:8000
